<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/header_back" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginLeft="16dp" android:layout_marginTop="16dp" />
    <Button android:id="@+id/btnAddReminder" style="@style/Btn" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:layout_marginRight="16dp"
        android:text="+  Add reminder" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" android:layout_marginLeft="16dp" android:layout_marginTop="10dp"
        android:text="Tap a reminder to edit  •  hold to delete"
        android:textColor="?attr/exMuted" android:textSize="12sp" />
    <ListView android:id="@+id/listReminders" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" />
</LinearLayout>