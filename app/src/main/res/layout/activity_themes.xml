<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/header_back" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginLeft="16dp" android:layout_marginTop="16dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" android:layout_marginLeft="16dp"
        android:text="Tap a theme to switch. Midnight Blue is the default."
        android:textColor="?attr/exMuted" android:textSize="12sp" />
    <ListView android:id="@+id/listThemes" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" />
</LinearLayout>