<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/exBg" android:gravity="center" android:orientation="vertical">
    <TextView android:id="@+id/splashLogo" android:layout_width="96dp" android:layout_height="96dp"
        android:background="@drawable/bg_logo" android:gravity="center" android:text="💰" android:textSize="44sp" />
    <TextView android:id="@+id/splashName" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:letterSpacing="0.06"
        android:textSize="38sp" android:textStyle="bold" />
    <TextView android:id="@+id/splashTag" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Smart money. Simple life."
        android:textColor="?attr/exMuted" android:textSize="14sp" />
    <com.example.expensetracker.DotsLoaderView android:id="@+id/splashLoader"
        android:layout_width="240dp" android:layout_height="60dp" android:layout_marginTop="56dp" />
    <TextView android:id="@+id/splashLoading" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Loading your wallet..." android:textColor="?attr/exMuted" android:textSize="12sp" />
</LinearLayout>