        <item name="exC5">#F6C9D8</item>
        <item name="exC6">#7D3050</item>
    </style>

    <!-- Buttons -->
    <style name="Btn" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/exAccent</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">?attr/exOnAccent</item>
    </style>
    <style name="Btn.Ghost">
        <item name="backgroundTint">?attr/exCard2</item>
        <item name="android:textColor">?attr/exText</item>
    </style>
    <style name="Btn.Danger">
        <item name="backgroundTint">#E5556E</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">?attr/exText</item>
        <item name="android:textColorHint">?attr/exMuted</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>