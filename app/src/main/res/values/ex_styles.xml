        <item name="exC5">#F0DDA8</item>
        <item name="exC6">#6F5A2B</item>
    </style>

    <!-- Shades of pink -->
    <style name="Theme.Expense.Pink">
        <item name="exBg">#130B11</item>
        <item name="exCard">#1E131B</item>
        <item name="exCard2">#2A1B25</item>
        <item name="exAccent">#D9769B</item>
        <item name="exOnAccent">#2A0B18</item>
        <item name="exCardStart">#B84F77</item>
        <item name="exCardEnd">#7E2E50</item>
        <item name="exText">#F6EAF0</item>
        <item name="exMuted">#A68B99</item>
