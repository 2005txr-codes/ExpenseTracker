<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- DEFAULT: Midnight Blue (your current design) -->
    <style name="Theme.Expense" parent="Theme.MaterialComponents.NoActionBar">
        <item name="exBg">#0A0D14</item>
        <item name="exCard">#141925</item>
        <item name="exCard2">#1C2230</item>
        <item name="exAccent">#2F80FF</item>
        <item name="exOnAccent">#FFFFFF</item>
        <item name="exCardStart">#2F80FF</item>
        <item name="exCardEnd">#1B5CD6</item>
        <item name="exText">#FFFFFF</item>
        <item name="exMuted">#8A93A6</item>
        <item name="exC1">#2F80FF</item>
        <item name="exC2">#FF9F1C</item>
        <item name="exC3">#2ED47A</item>
        <item name="exC4">#FF4D6A</item>
        <item name="exC5">#A66CFF</item>
        <item name="exC6">#22D3EE</item>

        <item name="colorPrimary">?attr/exAccent</item>
        <item name="colorOnPrimary">?attr/exOnAccent</item>
        <item name="colorSecondary">?attr/exAccent</item>
        <item name="colorSurface">?attr/exCard</item>
        <item name="colorOnSurface">?attr/exText</item>
        <item name="android:windowBackground">?attr/exBg</item>
        <item name="android:colorBackground">?attr/exBg</item>
        <item name="android:statusBarColor">?attr/exBg</item>
        <item name="android:navigationBarColor">?attr/exCard</item>
        <item name="android:textColorPrimary">?attr/exText</item>
        <item name="android:textColorSecondary">?attr/exMuted</item>
        <item name="android:textColorHint">?attr/exMuted</item>
    </style>

    <!-- Teal and grey -->
    <style name="Theme.Expense.Teal">
        <item name="exBg">#0B1113</item>
        <item name="exCard">#131C1F</item>
        <item name="exCard2">#1B272B</item>
        <item name="exAccent">#3FB8AF</item>
        <item name="exOnAccent">#04201D</item>
        <item name="exCardStart">#1F8F88</item>
        <item name="exCardEnd">#14625E</item>
        <item name="exText">#E4EDED</item>
        <item name="exMuted">#8A9C9E</item>
        <item name="exC1">#3FB8AF</item>
        <item name="exC2">#7FA5A8</item>
        <item name="exC3">#1F8F88</item>
        <item name="exC4">#B6C4C6</item>
        <item name="exC5">#5E7C80</item>
        <item name="exC6">#8FD8CF</item>
    </style>

    <!-- Gold and black -->
    <style name="Theme.Expense.Gold">
        <item name="exBg">#0A0A0A</item>
        <item name="exCard">#151412</item>
        <item name="exCard2">#1F1D18</item>
        <item name="exAccent">#C9A24A</item>
        <item name="exOnAccent">#1A1405</item>
        <item name="exCardStart">#9A7628</item>
        <item name="exCardEnd">#5F4818</item>
        <item name="exText">#F2EADB</item>
        <item name="exMuted">#9C937F</item>
        <item name="exC1">#C9A24A</item>
        <item name="exC2">#E6CB85</item>
        <item name="exC3">#8C6D2A</item>
