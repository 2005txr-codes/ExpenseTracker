<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/header_back" />
    <TextView android:id="@+id/tvTotal" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginLeft="16dp" android:layout_marginTop="16dp"
        android:textSize="18sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:layout_marginTop="2dp" android:layout_marginBottom="8dp"
        android:text="Tap a record to delete it" android:textColor="@color/ex_muted" android:textSize="12sp" />
    <ListView android:id="@+id/listTxns" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" />
    <Button android:id="@+id/btnClear" style="@style/Btn.Danger" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_margin="16dp"
        android:text="Delete all records in this category" />
</LinearLayout>