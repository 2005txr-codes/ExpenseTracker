<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <include layout="@layout/header_back" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="10dp" android:textColor="@color/ex_muted" android:textSize="13sp"
        android:text="Tap to select the categories you want to use. Long-press a custom one to delete it." />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_card" android:orientation="horizontal" android:padding="4dp">
        <TextView android:id="@+id/tvExpense" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:padding="12dp"
            android:text="Expense" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvIncome" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:padding="12dp"
            android:text="Income" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>

    <GridView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="8dp" android:layout_weight="1" android:numColumns="4"
        android:stretchMode="columnWidth" android:verticalSpacing="4dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText android:id="@+id/etIcon" style="@style/Input" android:layout_width="64dp"
            android:layout_height="wrap_content" android:gravity="center" android:inputType="text" />
        <EditText android:id="@+id/etCatName" style="@style/Input" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:layout_weight="1"
            android:hint="New category name" android:inputType="textCapWords" />
    </LinearLayout>
    <Button android:id="@+id/btnAddCat" style="@style/Btn.Ghost" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="+  Add custom category" />
    <Button android:id="@+id/btnSaveCats" style="@style/Btn" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Save" />
</LinearLayout>